# Version-control and workspace metadata are not needed by the running app.
.git
.github
.agents
.local
.cache

# Railway installs dependencies and creates production output during the build.
node_modules
dist
*.log

# Keep only the runtime-uploaded avatars. The remaining uploads are unused
# historical media and are not referenced by payment records.
uploads/*
!uploads/avatars/
!uploads/avatars/**

# The client imports these two logo files. All other workspace attachments are
# not imported by the application and would otherwise bloat the build snapshot.
attached_assets/*
!attached_assets/rr__1500_x_500_px_-removebg-preview_1769447899946.png
!attached_assets/rr__1500_x_500_px_-removebg-preview_1769451275347.png